# ============================================================
# 生产部署环境变量模板。复制为 .env.prod 并填写全部 REPLACE 项。
# 用法:
#   cp .env.prod.example .env.prod   # 填好密钥
#   bash scripts/gen-grafana-htpasswd.sh          # 生成 grafana basic_auth 凭据
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#       --env-file .env.prod --profile prod up -d --build
# 所有必需项在 prod overlay 中以 ${VAR:?} fail-fast:缺失直接拒绝启动,不存在静默默认值。
# 本文件已被 .gitignore 排除(仅 .example 入库),绝不提交真实密钥。
# ============================================================

# ---- 入口 ----
WEB_PORT=80
TLS_PORT=443
TLS_DOMAIN=example.com
TZ=Asia/Shanghai

# ---- MySQL ----
MYSQL_DATABASE=demo00
MYSQL_USER=demo00
MYSQL_PASSWORD=REPLACE-strong-mysql-password
MYSQL_ROOT_PASSWORD=REPLACE-strong-mysql-root-password

# ---- Redis(requirepass,建议启用)----
REDIS_PASSWORD=REPLACE-strong-redis-password
REDIS_MAXMEMORY=4gb
REDIS_CONTAINER_MEMORY=5g
VECTOR_STORE_BACKEND=redis-stack
MCP_ENABLED=true
# openssl rand -base64 32
MCP_CONFIG_ENCRYPTION_KEY=REPLACE-base64-32-byte-key
SPRING_AI_ENABLED=true
OPENAI_API_KEY=REPLACE-openai-compatible-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=gpt-4o-mini

# ---- 应用安全 ----
# 生成方式:openssl rand -base64 48
JWT_SECRET=REPLACE-at-least-32-random-bytes
# 生产默认关闭引导管理员;如首次部署需创建管理员,可临时 true,创建后立即改回 false
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=REPLACE-strong-admin-password

# ---- RAG 语料(必须为部署机器上的绝对路径)----
RAG_DOCS_PATH=/srv/demo00/docs
STARTUP_INGESTION_ENABLED=false

# ---- LLM(prod profile 无默认值,必填)----
EMBEDDING_API_KEY=REPLACE-siliconflow-api-key
LLM_URL=https://api.deepseek.com/chat/completions
LLM_MODEL=deepseek-chat
STREAMING_LLM_URL=https://api.deepseek.com/chat/completions
STREAMING_LLM_API_KEY=REPLACE-streaming-llm-api-key
STREAMING_LLM_MODEL=deepseek-chat
# Agent Function Calling(可选;false 时无需 AGENT_LLM_*)
AGENT_FUNCTION_CALLING_ENABLED=false
AGENT_LLM_URL=https://api.deepseek.com/chat/completions
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-chat
AGENT_LLM_THINKING_MODE=disabled

# ---- CORS:同源部署下留空(不发送 CORS 头 = 阻断一切跨域来源)----
CORS_ALLOWED_ORIGINS=

# ---- 监控 ----
GRAFANA_ADMIN_PASSWORD=REPLACE-strong-grafana-password
# nginx /grafana basic_auth 第一道门(由 scripts/gen-grafana-htpasswd.sh 生成 .htpasswd)
GRAFANA_BASIC_AUTH_USER=admin
GRAFANA_BASIC_AUTH_PASSWORD=REPLACE-strong-htpasswd-password

# 服务器防火墙:仅开放 80/tcp(与 SSH 22);prometheus/grafana/node-exporter 均不对外发布
