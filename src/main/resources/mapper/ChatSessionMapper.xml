<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.persistence.mapper.ChatSessionMapper">

    <resultMap id="ChatSessionResultMap" type="ChatSessionEntity">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="sessionId" column="session_id"/>
        <result property="title" column="title"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="ChatSessionColumns">
        id, user_id, session_id, title, create_time, update_time
    </sql>

    <insert id="upsert" parameterType="ChatSessionEntity">
        INSERT INTO `chat_session` (user_id, session_id, title)
        VALUES (#{userId}, #{sessionId}, #{title})
        ON DUPLICATE KEY UPDATE
            user_id = COALESCE(VALUES(user_id), user_id),
            title = CASE
                WHEN title = '新会话' THEN VALUES(title)
                ELSE title
            END
    </insert>

    <select id="findBySessionId" resultMap="ChatSessionResultMap">
        SELECT <include refid="ChatSessionColumns"/>
        FROM `chat_session`
        WHERE session_id = #{sessionId}
    </select>

    <select id="findByUserId" resultMap="ChatSessionResultMap">
        SELECT <include refid="ChatSessionColumns"/>
        FROM `chat_session`
        WHERE user_id = #{userId}
        ORDER BY update_time DESC
        LIMIT #{limit}
    </select>

    <update id="updateTitle">
        UPDATE `chat_session`
        SET title = #{title}
        WHERE session_id = #{sessionId}
    </update>

    <update id="touch">
        UPDATE `chat_session`
        SET update_time = CURRENT_TIMESTAMP(3)
        WHERE id = #{id}
    </update>
</mapper>
