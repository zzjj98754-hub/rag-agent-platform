<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.persistence.mapper.DocumentMapper">

    <resultMap id="DocumentResultMap" type="DocumentEntity">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="filePath" column="file_path"/>
        <result property="status" column="status"/>
        <result property="creatorId" column="creator_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="DocumentColumns">
        id, title, file_path, status, creator_id, create_time
    </sql>

    <insert id="upsert" parameterType="DocumentEntity">
        INSERT INTO `document` (title, file_path, status, creator_id)
        VALUES (#{title}, #{filePath}, #{status}, #{creatorId})
        ON DUPLICATE KEY UPDATE
            title = VALUES(title),
            status = VALUES(status),
            creator_id = COALESCE(VALUES(creator_id), creator_id)
    </insert>

    <select id="findById" resultMap="DocumentResultMap">
        SELECT <include refid="DocumentColumns"/>
        FROM `document`
        WHERE id = #{id}
    </select>

    <select id="findByFilePath" resultMap="DocumentResultMap">
        SELECT <include refid="DocumentColumns"/>
        FROM `document`
        WHERE file_path = #{filePath}
    </select>

    <select id="findByStatus" resultMap="DocumentResultMap">
        SELECT <include refid="DocumentColumns"/>
        FROM `document`
        WHERE status = #{status}
        ORDER BY id DESC
    </select>

    <select id="findAll" resultMap="DocumentResultMap">
        SELECT <include refid="DocumentColumns"/>
        FROM `document`
        ORDER BY create_time DESC, id DESC
    </select>

    <update id="updateStatusByFilePath">
        UPDATE `document`
        SET status = #{status}
        WHERE file_path = #{filePath}
    </update>

    <delete id="deleteById">
        DELETE FROM `document`
        WHERE id = #{id}
    </delete>
</mapper>
