# Docker Compose 本地(dev)部署示例。复制为 .env 后按需修改;不复制也可用内置 dev 默认值一键启动。
# 生产部署请改用 .env.prod.example + docker-compose.prod.yml overlay。
WEB_PORT=8080
PROMETHEUS_PORT=9091
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-grafana-password
SPRING_PROFILES_ACTIVE=dev
TZ=Asia/Hong_Kong

MYSQL_DATABASE=demo00
MYSQL_USER=demo00
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-root-password

# 非空则 Redis 启用 requirepass(dev 可留空)
REDIS_PASSWORD=
VECTOR_STORE_BACKEND=redis-stack
MCP_ENABLED=true
# Required only when an MCP Server stores credentials: openssl rand -base64 32
MCP_CONFIG_ENCRYPTION_KEY=
SPRING_AI_ENABLED=true
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

JWT_SECRET=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-admin-password

# Windows 示例：D:/docs；Linux/macOS 示例：/absolute/path/to/docs
RAG_DOCS_PATH=./docker/docs
STARTUP_INGESTION_ENABLED=false

# 启用启动入库时填写；不要把真实 Key 提交到 Git。
EMBEDDING_API_KEY=

# dev 默认指向内置 mock LLM(与 application-dev.yml 一致);真实同步 LLM 可在此覆盖
# LLM_URL=
# LLM_MODEL=

# OpenAI Compatible 流式接口，例如 https://api.openai.com/v1/chat/completions
STREAMING_LLM_URL=http://localhost:9090/mock-llm/stream
STREAMING_LLM_API_KEY=
STREAMING_LLM_MODEL=default

# Agent Function Calling（DeepSeek OpenAI Compatible）
AGENT_FUNCTION_CALLING_ENABLED=true
AGENT_LLM_URL=https://api.deepseek.com/chat/completions
AGENT_LLM_API_KEY=
AGENT_LLM_MODEL=deepseek-v4-flash
# disabled 延迟最低；复杂推理场景可临时改为 enabled
AGENT_LLM_THINKING_MODE=disabled

# 仅 prod overlay 使用(nginx /grafana basic_auth 第一道门,由 scripts/gen-grafana-htpasswd.sh 消费)
GRAFANA_BASIC_AUTH_USER=admin
GRAFANA_BASIC_AUTH_PASSWORD=
